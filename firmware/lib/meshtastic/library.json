      "+<modules/AdminModule.cpp>", "+<modules/TextMessageModule.cpp>",
      "+<Observer.cpp>", "+<FSCommon.cpp>", "+<SafeFile.cpp>", "+<meshUtils.cpp>", "+<memGet.cpp>",
      "+<UptimeClock.cpp>", "+<airtime.cpp>", "+<RedirectablePrint.cpp>", "+<DebugConfiguration.cpp>",
      "+<MessageStore.cpp>", "+<SerialConsole.cpp>", "+<mesh/StreamAPI.cpp>", "+<mesh/StreamFrameWriter.cpp>",
      "+<memory/MemAudit.cpp>", "+<DisplayFormatters.cpp>", "+<detect/ScanI2C.cpp>", "+<xmodem.cpp>", "+<SPILock.cpp>", "+<PowerMon.cpp>",
      "+<power/PowerHAL.cpp>", "+<modules/HopScalingModule.cpp>", "+<modules/KeyVerificationModule.cpp>",
      "+<modules/MeshBeaconModule.cpp>", "+<modules/NeighborInfoModule.cpp>", "+<modules/StatusLEDModule.cpp>",
      "+<modules/StatusMessageModule.cpp>", "+<modules/TrafficManagementModule.cpp>",
      "+<modules/Telemetry/DeviceTelemetry.cpp>"
